# Oasis Cognition configuration
# Copy to .env and fill in values

# --- LM Studio (OpenAI-compatible, local inference) ---
# LM Studio runs on http://localhost:1234/v1 with OpenAI-compatible API.
# Models use HuggingFace-style IDs. Available variants:
#   google/gemma-4-26b-a4b-qat   (26B total / 4B active, QAT,      262k ctx, tools+thinking+vision) ← recommended
#   google/gemma-4-12b            (12B,              Q4_K_M, 262k ctx, tools+thinking+vision)
#   google/gemma-4-12b-qat        (12B,              QAT,     262k ctx, tools+thinking+vision)
OASIS_OPENAI_BASE_URL=http://localhost:1234/v1
OASIS_OPENAI_API_KEY=lm-studio  # LM Studio accepts any non-empty key
OASIS_LLM_PROVIDER=openai
OASIS_LLM_MODEL=google/gemma-4-26b-a4b-qat
OASIS_LLM_MAX_TOKENS=8192

# --- Response Model (explanation generation) ---
OASIS_RESPONSE_LLM_PROVIDER=openai
OASIS_RESPONSE_LLM_MODEL=google/gemma-4-26b-a4b-qat

# --- Tool-plan Model (flat plan + thought layer; same client as tool-plan stream) ---
OASIS_TOOL_PLAN_LLM_PROVIDER=openai
OASIS_TOOL_PLAN_LLM_MODEL=google/gemma-4-26b-a4b-qat

# --- Vision (screen-share in response-generator; OpenAI-compatible multimodal) ---
# LM Studio's gemma-4-26b-a4b-qat supports vision
# OASIS_VISION_LLM_MODEL=google/gemma-4-26b-a4b-qat

# --- LM Studio / OpenAI-compatible gateway ---
# LM Studio is just an OpenAI-compatible endpoint at port 1234
# DeepSeek example: OASIS_OPENAI_BASE_URL=https://api.deepseek.com/v1


# --- Neo4j ---
OASIS_NEO4J_URI=bolt://localhost:7687
OASIS_NEO4J_USER=neo4j
OASIS_NEO4J_PASSWORD=oasis-cognition

# --- Redis ---
OASIS_REDIS_URL=redis://localhost:6379

# --- Logging ---
OASIS_LOG_LEVEL=INFO

# --- Scoring weights (logic engine) ---
OASIS_WEIGHT_EVIDENCE=0.4
OASIS_WEIGHT_MEMORY=0.25
OASIS_WEIGHT_RULE_MATCH=0.25
OASIS_WEIGHT_CONTRADICTION_PENALTY=0.1

# --- Langfuse (observability) ---
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-oasis
LANGFUSE_SECRET_KEY=sk-lf-oasis
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_INIT_USER_PASSWORD=changeme
# NEXTAUTH_SECRET=oasis-langfuse-secret-change-me
# LANGFUSE_SALT=oasis-salt-change-me
# Tool-plan debugging: when true, each tool-plan Langfuse span includes truncated JSON request + model output (can be large / sensitive)
# OASIS_DEBUG_TOOL_PLAN_PAYLOAD=true
# OASIS_DEBUG_TOOL_PLAN_MAX_CHARS=16000

# --- LiveKit (voice/video) ---
# Secret must be at least 32 chars for LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=oasis-livekit-dev-secret-min-32-chars

# --- Computer-Use (optional: separate model for CU calls) ---
# OASIS_COMPUTER_USE_LLM_MODEL=qwen3-vl-flash
# OASIS_COMPUTER_USE_LLM_BASE_URL=https://api.llmapi.ai/v1

# --- API Gateway (optional) ---
# MAX_TOOL_ITERATIONS=10  # Max tool calls per interaction (default 10)

# --- Pricing API (optional: auto-refresh model pricing from a remote source) ---
# When set, the gateway fetches pricing JSON from this URL on startup and
# periodically thereafter. The response must be a flat Record<provider:model, ModelPricing>.
# OASIS_PRICING_API_URL=https://pricing.oasis-cognition.com/v1/pricing.json
# OASIS_PRICING_REFRESH_INTERVAL_MS=3600000  # default 1 hour
# OASIS_PRICING_API_TIMEOUT_MS=10000         # default 10 seconds

# --- Yggdrasil (agent pool — controller + built-in Ratatoskr runner) ---
# The Yggdrasil agent pool runs the orchestration controller AND a built-in
# Ratatoskr sub-agent runner in a single process. There is always at least
# one runner (the built-in), so tasks work without any external setup.
#
# The api-gateway dispatches tasks by posting /runners/:runnerId/tasks and
# polls for completion via GET /runners/:runnerId/tasks.
# YGGDRASIL_URL=http://yggdrasil:3100         # default when compose profile active
# YGGDRASIL_API_KEY=                          # optional API key for auth
# YGGDRASIL_MAX_CONCURRENCY=4                 # max concurrent tasks per runner
# YGGDRASIL_POLL_INTERVAL_MS=5000             # runner task poll frequency
# YGGDRASIL_LEASE_TTL_MS=60000                # how long before offline detection
# YGGDRASIL_HEARTBEAT_INTERVAL_MS=15000       # runner heartbeat frequency

# --- Ratatoskr capability presets ---
# Capabilities ARE presets. Each name in CAPABILITIES is looked up as a preset;
# known presets resolve their transitive deps automatically. Unknown names pass
# through as raw capabilities. CAPABILITIES controls what the built-in runner
# advertises and which task handler modules are loaded.
#   CAPABILITIES=agent    → agent, llm, shell, web_search (transitive)
#   CAPABILITIES=llm,shell → llm, shell
#   CAPABILITIES=agent,code → agent, llm, shell, web_search, code
# CAPABILITIES=agent

# --- Ratatoskr sub-agent LLM (built-in runner) ---
# The built-in runner executes sub-agent tasks using its own LLM (think-act-
# execute loop with shell/file/web tools). Configure its LLM access here.
# These env vars are consumed by the yggdrasil-pool container (not the gateway).
# Default: LM Studio with google/gemma-4-26b-a4b-qat
LLM_MODEL=google/gemma-4-26b-a4b-qat
LLM_BASE_URL=http://host.docker.internal:1234/v1
# LLM_API_KEY=lm-studio               # LM Studio accepts any non-empty key; falls back to OASIS_OPENAI_API_KEY
LLM_MAX_TOOL_ITERATIONS=25              # max think-act-execute cycles

# --- Ratatoskr cost tracking ---
# Cost is computed server-side by the api-gateway's PricingService using
# the model and token counts reported by the runner. No env vars needed.


# --- Code capability overrides ---
# When CAPABILITIES includes "code", the code preset depends on llm and
# uses these values (defaults shown are for LM Studio + gemma-4-26b-a4b-qat).
# Available gemma-4 variants (matching model-variants.ts registry):
#   google/gemma-4-26b-a4b-qat   (26B, QAT,      tools+thinking+vision)
#   google/gemma-4-12b            (12B, Q4_K_M, tools+thinking+vision)
#   google/gemma-4-12b-qat        (12B, QAT,      tools+thinking+vision)
# CODE_LLM_MODEL=google/gemma-4-26b-a4b-qat
# CODE_LLM_BASE_URL=http://host.docker.internal:1234/v1
# CODE_LLM_API_KEY=                            # optional for LM Studio; falls back to OASIS_OPENAI_API_KEY
# CODE_TEMPERATURE=0.2
# CODE_MAX_TOKENS=8192
