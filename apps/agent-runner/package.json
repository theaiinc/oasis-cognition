    "axios": "^1.7.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "nanoid": "^5.0.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
