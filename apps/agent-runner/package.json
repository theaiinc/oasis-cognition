{
  "name": "oasis-agent-runner",
  "version": "0.1.1",
  "description": "Oasis Cognition agent runner — Docker container for subagent execution and registry",
  "private": true,
  "engines": {
    "node": ">=20.14.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "tsx src/yggdrasil-pool.ts",
    "start:dev": "tsx watch src/yggdrasil-pool.ts",
    "start:runner": "tsx src/registry.ts",
    "start:runner:dev": "tsx watch src/registry.ts"
  },
  "dependencies": {
    "@theaiinc/yggdrasil": "file:theaiinc-yggdrasil-0.2.3.tgz",
