{
  "name": "oasis-mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol server exposing Oasis Cognition capabilities as tools.",
  "private": true,
  "type": "module",
  "bin": {
    "oasis-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20.14.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "MCP_TRANSPORT=stdio node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.0",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
